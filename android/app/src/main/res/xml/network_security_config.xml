<?xml version="1.0" encoding="utf-8"?>
<!--
  Standard: nur HTTPS mit System-Zertifikaten. Klartext-HTTP ist plattformseitig
  zugelassen, wird von CHAKOTAY aber ausschließlich nach ausdrücklicher Bestätigung
  durch den Benutzer verwendet (z. B. lokaler Testserver). Benutzerinstallierte
  Zertifikate werden nicht vertraut.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
